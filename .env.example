DB_URL=jdbc:mariadb://localhost:3306/ordersystem
DB_USERNAME=root
DB_PASSWORD=change-me
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_SSL_ENABLED=false
ORDER_STOCK_PROCESSING_MODE=REDIS_ASYNC
JWT_SECRET_KEY=change-me
JWT_SECRET_KEY_RT=change-me
# 로컬에서만 SDK 표준 변수를 사용한다. EKS에서는 IRSA로 대체하며 아래 키를 주입하지 않는다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=order-system-bucket
CORS_ALLOWED_ORIGINS=http://localhost:8081
BOOTSTRAP_ADMIN_ENABLED=false
# ADMIN_EMAIL은 주문 알림 수신자이므로 초기화 후에도 유지한다.
ADMIN_EMAIL=admin@example.test
# 빈 DB 초기화 시 1개 인스턴스에서만 설정하고, 완료 후 비밀번호를 제거한다.
BOOTSTRAP_ADMIN_PASSWORD=
